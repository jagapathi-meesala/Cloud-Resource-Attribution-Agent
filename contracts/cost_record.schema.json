{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cloud Cost Record",
  "type": "object",
  "required": [
    "record_id",
    "resource_id",
    "service",
    "cost",
    "currency",
    "tags"
  ],
  "additionalProperties": false,
  "properties": {
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "resource_id": {
      "type": "string",
      "minLength": 1
    },
    "service": {
      "type": "string",
      "minLength": 1
    },
    "cost": {
      "type": [
        "number",
        "string"
      ],
      "minimum": 0
    },
    "currency": {
      "type": "string",
      "minLength": 3,
      "maxLength": 3
    },
    "tags": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
